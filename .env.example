# Public Expo client variables only.
# Values prefixed with EXPO_PUBLIC_ are bundled into the app. Never put
# service-role keys, LLM provider secrets, or other privileged credentials here.

# Supabase > Project Settings > API
# The key is the public one. Newer dashboards call it the publishable key and
# older ones the anon key; either variable name works.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Copy this file to .env for local development. Do not commit .env.
