# Public Expo client variables only.
# Values prefixed with EXPO_PUBLIC_ are bundled into the app. Never put
# service-role keys, LLM provider secrets, or other privileged credentials here.

# Supabase > Project Settings > API
# The key is the public one. Newer dashboards call it the publishable key and
# older ones the anon key; either variable name works.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Copy this file to .env for local development. Do not commit .env.

# ---------------------------------------------------------------------------
# Server-side only. These are NOT client variables and must never be prefixed
# with EXPO_PUBLIC_ — that prefix bundles a value into the app binary.
#
# They belong in Supabase Edge Function secrets, not in this file and not in
# any .env the app reads:
#
#   npx supabase secrets set OPENAI_API_KEY=...
#
# Names only, for reference:
#   OPENAI_API_KEY                    provider secret
#   AI_SEARCH_PROVIDER                openai | deterministic
#   OPENAI_SEARCH_MODEL               e.g. gpt-5.6-sol
#   OPENAI_SEARCH_TIMEOUT_MS          e.g. 6000
#   OPENAI_MAX_OUTPUT_TOKENS          e.g. 2000
#   OPENAI_SEARCH_REASONING_EFFORT    minimal | low | medium | high
