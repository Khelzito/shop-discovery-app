{
  "//": "Standalone on purpose: the Expo base config targets a bundler, while ai/ is plain TypeScript that must also run under Deno. Deno requires explicit .ts specifiers, so rewriteRelativeImportExtensions turns them into .js on emit for Node.",
  "compilerOptions": {
    "strict": true,
    "noEmit": false,
    "outDir": "dist-test",
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "es2022",
    "lib": [
      "es2022"
    ],
    "types": [
      "node"
    ],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": [
    "ai/**/*.ts",
    "data/shops/mapper.ts",
    "data/shops/home-sections.ts",
    "data/shops/mapper.test.ts",
    "data/search/intent-filters.ts",
    "data/search/rank.ts",
    "data/search/search.test.ts",
    "types/shop.ts",
    "lib/http-url.ts"
  ]
}
